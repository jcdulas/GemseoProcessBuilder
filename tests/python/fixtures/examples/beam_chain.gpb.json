  "metadata": {
    "created": "2026-09-25T15:00:00+00:00",
    "description": "Beam chain: the section, the loads, the stress and the mass of a cantilever beam, computed one after the other by an assembly run as a chain, in order. A DOE varies the width and the height of the section.",
    "gpb_version": "0.1.0",
    "name": "Beam chain"
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "children": [
              {
                "config": {
                  "expressions": {
                    "area": "width*height",
                    "inertia": "width*height**3/12"
                  }
                },
                "id": "n-section",
                "kind": "analytic",
                "name": "Section",
                "ports": [
                  {
                    "direction": "in",
                    "local_name": "width",
                    "shape": [
                      1
                    ],
                    "default": 0.1,
                    "default_text": "0.1"
                  },
                  {
                    "direction": "in",
                    "local_name": "height",
                    "shape": [
                      1
                    ],
                    "default": 0.2,
                    "default_text": "0.2"
                  },
                  {
                    "direction": "out",
                    "local_name": "area",
                    "shape": [
                      1
                    ]
                  },
                  {
                    "direction": "out",
                    "local_name": "inertia",
                    "shape": [
                      1
                    ]
                  }
                ],
                "type": "component"
              },
              {
                "config": {
                  "expressions": {
